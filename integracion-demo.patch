+export default function AdminVisitas() {
+  const [visitas, setVisitas] = useState<any[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [busqueda, setBusqueda] = useState('');
+  const [fechaFiltro, setFechaFiltro] = useState('');
+
+  useEffect(() => {
+    setFechaFiltro(new Date().toISOString().split('T')[0]);
+  }, []);
+
+  useEffect(() => {
+    if (!fechaFiltro) return;
+
+    async function cargar() {
+      setLoading(true);
+      const inicio = `${fechaFiltro}T00:00:00`;
+      const fin = `${fechaFiltro}T23:59:59`;
+
+      const { data } = await supabase
+        .from('visits')
+        .select('*, visitors(full_name, doc_number), units(code, towers(name))')
+        .gte('created_at', inicio)
+        .lte('created_at', fin)
+        .order('created_at', { ascending: false });
+      
+      if (data) setVisitas(data);
+      setLoading(false);
+    }
+    cargar();
+  }, [fechaFiltro]);
+
+  const filtrados = visitas.filter(v => 
+    (v.visitors as any)?.full_name?.toLowerCase().includes(busqueda.toLowerCase()) || 
+    (v.visitors as any)?.doc_number?.includes(busqueda)
+  );
+
+  return (
+    <div className="flex-1 overflow-y-auto">
+      <header className="bg-white border-b border-slate-200 h-16 flex items-center px-8 justify-between sticky top-0 z-10">
+        <h1 className="text-xl font-bold text-slate-800">Historial de Visitas</h1>
+      </header>
+
+      <div className="p-8 max-w-6xl mx-auto">
+        <div className="flex flex-col md:flex-row gap-4 mb-6 justify-between items-center">
+          <input 
+            type="text" 
+            placeholder="Buscar por nombre o documento..."
+            value={busqueda}
+            onChange={(e) => setBusqueda(e.target.value)}
+            className="w-full md:w-1/2 rounded-lg border border-slate-300 px-4 py-2 text-sm text-slate-900 focus:border-[#1E3A5F] focus:outline-none"
+          />
+          <div className="relative w-full md:w-auto">
+            <input 
+              type="date" 
+              value={fechaFiltro}
+              onChange={(e) => setFechaFiltro(e.target.value)}
+              className="w-full rounded-lg border border-slate-300 px-4 py-2 text-sm text-slate-900 focus:border-[#1E3A5F] focus:outline-none"
+            />
+            <span className="absolute -top-2 left-2 bg-white px-1 text-[10px] text-slate-500 font-bold">FECHA</span>
+          </div>
+        </div>
+
+        <div className="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
+          <table className="w-full text-left text-sm">
+            <thead className="bg-slate-50 text-xs uppercase text-slate-500 border-b">
+              <tr>
+                <th className="px-6 py-4">Foto</th>
+                <th className="px-6 py-4">Visitante</th>
+                <th className="px-6 py-4">Documento</th>
+                <th className="px-6 py-4">Visita a</th>
+                <th className="px-6 py-4">Estado</th>
+                <th className="px-6 py-4">Hora</th>
+              </tr>
+            </thead>
+            <tbody className="divide-y divide-slate-100">
+              {loading ? <tr><td colSpan={6} className="p-8 text-center">Cargando...</td></tr> : 
+               filtrados.length === 0 ? <tr><td colSpan={6} className="p-8 text-center text-slate-400">No hay visitas registradas en esta fecha.</td></tr> :
+               filtrados.map(v => (
+                <tr key={v.id} className="hover:bg-slate-50">
+                  <td className="px-6 py-3">
+                    {v.photo_url ? (
+                      <EvidenceImage src={v.photo_url} alt="Visitante" className="h-10 w-10 object-cover rounded-full shadow-sm" />
+                    ) : (
+                      <div className="h-10 w-10 bg-slate-100 rounded-full flex items-center justify-center text-[10px] text-slate-400 border border-slate-200">N/A</div>
+                    )}
+                  </td>
+                  <td className="px-6 py-3 font-semibold text-slate-900">{(v.visitors as any)?.full_name}</td>
+                  <td className="px-6 py-3 text-slate-600">{(v.visitors as any)?.doc_number}</td>
+                  <td className="px-6 py-3 text-xs font-semibold text-[#1E3A5F]">
+                    {(v.units as any)?.towers?.name} - {getHouseNumber((v.units as any)?.code)}
+                  </td>
+                  <td className="px-6 py-3">
+                    <span className={`px-2 py-1 rounded-full text-xs font-medium ${
+                      v.status === 'checked_in' ? 'bg-blue-100 text-blue-800' : 
+                      v.status === 'authorized' ? 'bg-amber-100 text-amber-800' : 
+                      'bg-slate-100 text-slate-600'
+                    }`}>
+                      {v.status === 'checked_in' ? 'Adentro' : v.status === 'authorized' ? 'Esperando' : 'Salió'}
+                    </span>
+                  </td>
+                  <td className="px-6 py-3 text-xs text-slate-600">
+                    {v.check_in_at ? new Date(v.check_in_at).toLocaleTimeString('es-CO') : 'No ingresó'}
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      </div>
+    </div>
+  );
+}
